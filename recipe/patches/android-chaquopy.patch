--- a/setup.py
+++ b/setup.py
@@ -105,5 +105,25 @@ def build_libraries():
     conf = 'Debug' if int(os.getenv('DEBUG', 0)) else 'Release'
     cmake_args = ['cmake', '-B', BUILD_DIR, "-DCMAKE_BUILD_TYPE=" + conf, "-DUNICORN_BUILD_TESTS=off"]
+    # Chaquopy generates a CMake toolchain whose compilers, sysroot and linker
+    # flags target Android. Upstream's Python build doesn't forward it because
+    # ordinary desktop wheels don't need cross compilation.
+    toolchain = os.getenv("CMAKE_TOOLCHAIN_FILE")
+    if toolchain:
+        # build-wheel adds libpython to every Python package. Unicorn's Python
+        # API is pure ctypes and the C engine neither embeds nor extends
+        # Python, so that dependency is both unnecessary and invalid during
+        # CMake's Android compiler checks.
+        python_version = os.environ["CHAQUOPY_PYTHON"]
+        os.environ["LDFLAGS"] = os.environ["LDFLAGS"].replace(
+            "-lpython" + python_version, ""
+        )
+        cmake_args += [
+            "-DCMAKE_TOOLCHAIN_FILE=" + toolchain,
+            "-DANDROID_ABI=" + os.environ["CHAQUOPY_ABI"],
+            # Anisette's arm64-v8a library bundle only executes AArch64 code.
+            # Removing unrelated backends materially reduces APK size.
+            "-DUNICORN_ARCH=aarch64",
+        ]
     if os.getenv("UNICORN_TRACER"):
         cmake_args += ["-DUNICORN_TRACER=on"]
     if conf == 'Debug':
         cmake_args += ["-DUNICORN_LOGGING=on"]
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -318,8 +318,12 @@ else()
     set(EXTRA_CFLAGS "${EXTRA_CFLAGS}-fPIC")
     if(ANDROID_ABI)
-        set(EXTRA_CFLAGS "${EXTRA_CFLAGS} --target=${CMAKE_C_COMPILER_TARGET}")
-        set(EXTRA_CFLAGS "${EXTRA_CFLAGS} --sysroot=${CMAKE_SYSROOT}")
+        if(CMAKE_C_COMPILER_TARGET)
+            set(EXTRA_CFLAGS "${EXTRA_CFLAGS} --target=${CMAKE_C_COMPILER_TARGET}")
+        endif()
+        if(CMAKE_SYSROOT)
+            set(EXTRA_CFLAGS "${EXTRA_CFLAGS} --sysroot=${CMAKE_SYSROOT}")
+        endif()
     endif()
     if(UNICORN_FUZZ)
         set(EXTRA_CFLAGS "${EXTRA_CFLAGS} ${CMAKE_C_FLAGS}")
